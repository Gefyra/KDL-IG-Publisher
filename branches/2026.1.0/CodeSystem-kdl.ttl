  fhir:CodeSystem.version [ fhir:value "2026.1.0"] ;
  fhir:CodeSystem.name [ fhir:value "KDL"] ;
  fhir:CodeSystem.title [ fhir:value "CodeSystem Klinische Dokumentenklassen-Liste 2026"] ;
  fhir:CodeSystem.status [ fhir:value "active"] ;
  fhir:CodeSystem.experimental [ fhir:value "false"^^xsd:boolean] ;
  fhir:CodeSystem.date [ fhir:value "2026-01-01"^^xsd:date] ;
