     fhir:CodeSystem.concept.display [ fhir:value "Medikationsplan elektronisch (eMP)" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Der eMP enthält einen strukturierten Überblick darüber, welche Medikamente ein Versicherter aktuell einnimmt. Darüber hinaus enthält der eMP medikationsrelevante Informationen, die wichtig sind, um unerwünschte Wechselwirkungen zu vermeiden, bspw. zu Allergien. Exkl.: Medikamentenplan. Detailinformationen: gematik (2021): https://fachportal.gematik.de/anwendungen/elektronischer-medikationsplan. Zugegriffen: 18.02.2022" ] ;
     fhir:CodeSystem.concept.property [
