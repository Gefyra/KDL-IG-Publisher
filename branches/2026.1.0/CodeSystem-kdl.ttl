     fhir:Extension.valueDate [ fhir:value "2026-01-13"^^xsd:date ]
  ] ;
  fhir:CodeSystem.url [ fhir:value "http://dvmd.de/fhir/CodeSystem/kdl"] ;
  fhir:CodeSystem.identifier [
