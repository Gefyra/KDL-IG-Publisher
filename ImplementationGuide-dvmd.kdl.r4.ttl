  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"de-DE\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"de-DE\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide dvmd.kdl.r4</b></p><a name=\"dvmd.kdl.r4\"> </a><a name=\"hcdvmd.kdl.r4\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Language: de-DE</p></div><h2>KDL</h2><p>The official URL for this implementation guide is: </p><pre>http://dvmd.de/fhir/ImplementationGuide/dvmd.kdl.r4</pre><div><p>Das Package enthält die KDL im FHIR-Format für den Datenaustausch im Kontext der elektronischen Patientenakte. Die Zusammenstellung des FHIR Pakets basiert auf den Inhalten, die seitens DVMD e.V. zur Verfügung gestellt wurden.</p>\n</div></div>"
  ] ;
